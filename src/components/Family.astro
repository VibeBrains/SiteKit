---
import Lines from './Lines.astro'
import { brandIcons, productNames, products, type Product } from '../brands'

/**
 * The family section: the product of this site first with its badge, then its siblings as links
 * Texts come from the site's catalog; names and icons are the family's own
 */
interface Props {
  here: Product
  eyebrow: string
  title: string
  lead: string
  hereLabel: string
  openLabel: string
  /** One line about each product */
  texts: Record<Product, string>
  /** Where each sibling leads */
  links: Record<Product, string>
}

const { here, eyebrow, title, lead, hereLabel, openLabel, texts, links } = Astro.props
const siblings = products.filter((product) => product !== here)
---

<section class="section family">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 class="section-title" data-reveal style="--reveal-i: 1"><Lines text={title} /></h2>
      <p class="section-lead" data-reveal style="--reveal-i: 2"><Lines text={lead} /></p>
    </div>

    <div class="products">
      <div class="product product--here" data-reveal style="--reveal-i: 0">
        <div class="product-inner" data-tilt-card>
          <span class="badge">{hereLabel}</span>
          <span class="product-mark" aria-hidden="true">
            <img src={brandIcons[here]} alt="" width="56" height="56" />
          </span>
          <h3>{productNames[here]}</h3>
          <p>{texts[here]}</p>
        </div>
      </div>
      {
        siblings.map((product, i) => (
          <a class="product" href={links[product]} rel="noopener" data-reveal style={`--reveal-i: ${i + 1}`}>
            <span class="product-inner" data-tilt-card>
              <span class="product-mark" aria-hidden="true">
                <img src={brandIcons[product]} alt="" width="56" height="56" />
              </span>
              <span class="product-name">{productNames[product]}</span>
              <span class="product-text">{texts[product]}</span>
              <span class="product-open">{openLabel}</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .products {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 860px) {
    .products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .product {
    perspective: 900px;
    color: inherit;
  }

  .product:hover {
    color: inherit;
  }

  .product-inner {
    --tx: 0deg;
    --ty: 0deg;
    position: relative;
    display: grid;
    gap: 10px;
    height: 100%;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    transform: rotateX(var(--tx)) rotateY(var(--ty));
    transform-style: preserve-3d;
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.3s;
  }

  .product--here .product-inner {
    border-color: var(--family-here-border, var(--border-strong));
    background:
      var(--family-here-tint, linear-gradient(transparent, transparent)),
      linear-gradient(180deg, var(--surface-2), var(--surface));
  }

  a.product:hover .product-inner {
    border-color: var(--border-strong);
  }

  .product-mark {
    display: block;
    transform: translateZ(40px);
    filter: drop-shadow(0 12px 22px rgb(0 0 0 / 0.5));
  }

  h3,
  .product-name {
    color: var(--fg);
    font-family: var(--font-accent);
    font-size: 20px;
    font-weight: 700;
    transform: translateZ(24px);
  }

  .product-inner p,
  .product-text {
    color: var(--fg-muted);
    font-size: 15px;
    transform: translateZ(12px);
  }

  .product-open {
    margin-top: 4px;
    color: var(--brand-bright);
    font-size: 15px;
    font-weight: 600;
  }

  .product-open::after {
    content: ' →';
  }

  .badge {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-bright);
    font-family: var(--font-accent);
    font-size: 12px;
  }
</style>
